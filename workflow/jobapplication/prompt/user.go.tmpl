<task>
Apply to the job posting at: {{.JobPostingUrl}}
</task>

<context_ids>
  <id_user>{{.IdUser}}</id_user>
  <id_job_application>{{.IdJobApplication}}</id_job_application>
</context_ids>

<candidate>
   <candidate_profile>
   {{.UserProfile}}
   </candidate_profile>

   <candidate_resume>
   {{.UserResume}}
   </candidate_resume>

   <candidate_resume_path>
   This is the location of the candidate's resume on the file system:
      <path>
         {{.UserResumePath}}
      </path>
   </candidate_resume_path>
</candidate>

<job_description>
{{.JobDescription}}
</job_description>

<current_page>
<interactive_elements>
{{if .TaggedNodes}}The following elements are visible and interactive on the current page:
{{range .TaggedNodes}}
<tagged_node>
index: {{.Index}}
description: {{.Description}}
x: {{printf "%.0f" .X}}
y: {{printf "%.0f" .Y}}
width: {{printf "%.0f" .Width}}
height: {{printf "%.0f" .Height}}
</tagged_node>
{{end}}{{else}}No interactive elements detected on the current page.{{end}}
</interactive_elements>

<file_input_elements>
{{if .TaggedFileInputElements}}The following file input elements are visible on the current page:
{{range .TaggedFileInputElements}}
<file_input>
index: {{.Index}}
html: {{.HTML}}
label: {{if .Label}}{{.Label}}{{else}}(none){{end}}
value: {{if .Value}}{{.Value}}{{else}}(none){{end}}
</file_input>
{{end}}{{else}}No file input elements present in the current page.{{end}}
</file_input_elements>
</current_page>

<action_history>
{{if .ToolCallHistory}}Previous actions taken in this session:
{{range $i, $call := .ToolCallHistory}}
{{add $i 1}}. Tool: {{$call.Name}}
   Arguments: {{json $call.Arguments}}
   Error: {{if $call.Error}}{{$call.Error}}{{else}}nil{{end}}
   {{if $call.Result}}Result: {{json $call.Result}}{{end}}
{{end}}{{else}}No actions taken yet. This is the first interaction.{{end}}
</action_history>

<instructions>
Analyze the current page screenshot and determine the next action to complete the job application. Remember to:
1. Retrieve the job description first if you haven't already
2. Check what form fields need to be filled
3. Use the user's resume information to complete the application
4. Submit when all required fields are complete

Respond with your decision in the required JSON format.
</instructions>